# Telegram
BOT_TOKEN=123456:ABC-DEF_your_token_from_BotFather
# Comma-separated Telegram user IDs with admin privileges (optional)
ADMIN_IDS=
# Optional SOCKS/HTTP proxy when VPS cannot reach api.telegram.org
# Same as mks-partners: socks5h://user:pass@host:port
TELEGRAM_PROXY_URL=
# HTTPS URL of Next.js Mini App (use ngrok/cloudflare tunnel for local)
WEBAPP_URL=https://your-tunnel.example.com
BACKEND_URL=http://localhost:8000

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://shop:shop_secret@localhost:5432/shop_db

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=products
MINIO_SECURE=false
MINIO_PUBLIC_URL=http://localhost:9000

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=shop-bot-queue
# Optional label prepended to the worker identity. Leave empty in shared .env:
# each process appends hostname:pid, so several workers can poll the same queue.
# WORKER_IDENTITY=

# CORS
API_CORS_ORIGINS=http://localhost:3000,https://web.telegram.org
